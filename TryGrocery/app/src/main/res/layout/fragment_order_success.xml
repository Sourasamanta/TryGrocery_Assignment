<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Animated success circle -->
    <FrameLayout
        android:layout_width="160dp"
        android:layout_height="160dp">

        <View
            android:id="@+id/successCircle"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="@drawable/shape_success_circle" />

        <ImageView
            android:id="@+id/checkIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_menu_send"
            android:tint="@color/white"
            android:contentDescription="Success" />
    </FrameLayout>

    <TextView
        android:id="@+id/orderPlacedText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Order Placed!"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/orderIdText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Order #000001"
        android:textColor="@color/green_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Your order is confirmed and will be delivered soon."
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <Button
        android:id="@+id/goHomeButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/shape_primary_button"
        android:text="Go to Home"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
